{
  "name": "axonssh",
  "version": "0.1.1",
  "description": "A local-first SSH desktop workspace with terminals and AI-assisted operations",
  "main": "./out/main/index.js",
  "author": "AxonSSH contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "npm run build && playwright test",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --config.npmRebuild=false",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "format": "prettier --write src tests docs/*.md README.md *.json *.ts .github/workflows/*.yml",
    "format:check": "prettier --check src tests docs/*.md README.md *.json *.ts .github/workflows/*.yml"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "ssh2": "^1.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.axonssh.desktop",
    "productName": "AxonSSH",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/sql.js/dist/*.wasm"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
